    "from reportlab.lib.styles import getSampleStyleSheet\n",
    "\n",
    "pdf_file = \"Web_Application_Security_Report.pdf\"\n",
    "\n",
    "doc = SimpleDocTemplate(\n",
    "    pdf_file,\n",
    "    pagesize=A4\n",
    ")\n",
    "\n",
    "styles = getSampleStyleSheet()\n",
    "\n",
    "content = []\n",
    "\n",
    "content.append(\n",
    "    Paragraph(\n",
    "        \"WEB APPLICATION SECURITY TESTING\",\n",
    "        styles[\"Title\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "content.append(Spacer(1, 20))\n",
    "\n",
    "content.append(\n",
    "    Paragraph(\n",
    "        \"Final Vulnerability Assessment Report\",\n",
    "        styles[\"Heading2\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "content.append(Spacer(1, 20))\n",
    "\n",
    "content.append(\n",
    "    Paragraph(\n",
    "        \"Testing Environment: Python Jupyter Notebook\",\n",
    "        styles[\"Normal\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "content.append(\n",
    "    Paragraph(\n",
    "        \"Assessment Type: Local Security Simulation\",\n",
    "        styles[\"Normal\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "content.append(Spacer(1, 20))\n",
    "\n",
    "table_data = [\n",
    "    [\"ID\", \"Vulnerability\", \"Risk\", \"Status\"]\n",
    "]\n",
    "\n",
    "for _, row in report_df.iterrows():\n",
    "    table_data.append([\n",
    "        row[\"Vulnerability ID\"],\n",
    "        row[\"Vulnerability\"],\n",
